<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MgsvModBldr.Tools.Cli</RootNamespace>
    <AssemblyName>MgsvModBldr.Tools.Cli</AssemblyName>
  </PropertyGroup>
  <!-- Wrapper DLL: dispatches to every per-tool DLL. Each tool lives in
       its own project/DLL (folder name == DLL name) so the toolset is
       modular. The thin modbldr-tools.exe launcher forwards argv here. -->
  <ItemGroup>
    <ProjectReference Include="..\..\mgsv_modbldr\csgui\MgsvModBldr.Core\MgsvModBldr.Core.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.GameHashing\MgsvModBldr.Tools.GameHashing.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fsop\MgsvModBldr.Tools.Fsop.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Ftex\MgsvModBldr.Tools.Ftex.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fox\MgsvModBldr.Tools.Fox.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Qar\MgsvModBldr.Tools.Qar.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fpk\MgsvModBldr.Tools.Fpk.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Pftxs\MgsvModBldr.Tools.Pftxs.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Translation\MgsvModBldr.Tools.Translation.csproj" />
  </ItemGroup>
  <!-- Per-tool test suites (the `test` subcommand aggregates these via
       IToolTests). Each lives next to its tool so a tool can be lifted
       out with its verification intact. -->
  <ItemGroup>
    <ProjectReference Include="..\MgsvModBldr.Tools.Testing\MgsvModBldr.Tools.Testing.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fsop.Tests\MgsvModBldr.Tools.Fsop.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fox.Tests\MgsvModBldr.Tools.Fox.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Ftex.Tests\MgsvModBldr.Tools.Ftex.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Qar.Tests\MgsvModBldr.Tools.Qar.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Fpk.Tests\MgsvModBldr.Tools.Fpk.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Pftxs.Tests\MgsvModBldr.Tools.Pftxs.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Translation.Tests\MgsvModBldr.Tools.Translation.Tests.csproj" />
  </ItemGroup>
</Project>
