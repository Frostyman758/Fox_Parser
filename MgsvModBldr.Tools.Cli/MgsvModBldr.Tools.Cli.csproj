    <ProjectReference Include="..\MgsvModBldr.Tools.Fv2.Tests\MgsvModBldr.Tools.Fv2.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Hlsl.Tests\MgsvModBldr.Tools.Hlsl.Tests.csproj" />
    <ProjectReference Include="..\MgsvModBldr.Tools.Sbp.Tests\MgsvModBldr.Tools.Sbp.Tests.csproj" />
