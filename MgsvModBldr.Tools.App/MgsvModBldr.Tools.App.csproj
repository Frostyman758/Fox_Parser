<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MgsvModBldr.Tools.App</RootNamespace>
    <AssemblyName>modbldr-tools</AssemblyName>
  </PropertyGroup>
  <!-- Wrapper executable. Forwards argv to the wrapper DLL. -->
  <ItemGroup>
    <ProjectReference Include="..\MgsvModBldr.Tools.Cli\MgsvModBldr.Tools.Cli.csproj" />
  </ItemGroup>
  <!-- The fox splash sits loose next to the exe. -->
  <ItemGroup>
    <None Include="..\fox_logo.txt" Link="fox_logo.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <!-- Dictionaries live in a tidy dict/ folder next to the exe (never
       embedded, so they can be updated independently). Every tool resolves
       them from <baseDir>/dict/ (with a loose-beside fallback). -->
  <ItemGroup>
    <None Include="..\qar_dictionary.txt" Link="dict\qar_dictionary.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\twpf_stringId_dictionary.txt" Link="dict\twpf_stringId_dictionary.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\lang_dictionary.txt" Link="dict\lang_dictionary.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\mtar_dictionary.txt" Link="dict\mtar_dictionary.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\spch_*dictionary.txt">
      <Link>dict\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\rdf_*_dictionary.txt">
      <Link>dict\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
