<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MgsvModBldr.Tools.Tcvp</RootNamespace>
    <AssemblyName>MgsvModBldr.Tools.Tcvp</AssemblyName>
  </PropertyGroup>
  <!-- TcvpTool port: .tcvp cover-point locators (GZ + TPP variants).
       No hashing/deps. NOTE: the reference TcvpTool 0.6 has a Read bug
       (adds each locator to the list TWICE) that corrupts round-trips;
       this port fixes it (single add) and is verified byte-exact against
       the original game files. -->
</Project>
