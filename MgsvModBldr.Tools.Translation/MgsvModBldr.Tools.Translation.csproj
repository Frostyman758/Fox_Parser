<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MgsvModBldr.Tools.Translation</RootNamespace>
    <AssemblyName>MgsvModBldr.Tools.Translation</AssemblyName>
  </PropertyGroup>
  <!-- FoxEngine.TranslationTool port: .subp (subtitles), .ffnt (fonts),
       .lng (language). Subp uses ISO-8859-5 (rus) via the CodePages provider,
       which is part of the .NET 10 shared framework — no package needed. -->
  <!-- Lang (.lng) StrCode32 reuses GameCityHash (== game hashing). -->
  <ItemGroup>
    <ProjectReference Include="..\MgsvModBldr.Tools.GameHashing\MgsvModBldr.Tools.GameHashing.csproj" />
  </ItemGroup>
</Project>
